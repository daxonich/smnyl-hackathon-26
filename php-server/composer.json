{
    "name": "insurance-assignment/php-server",
    "description": "PHP/MariaDB port of the chat-based insurance agent assignment system",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "ramsey/uuid": "4.7.6"
    },
    "require-dev": {
        "phpunit/phpunit": "11.5.21",
        "giorgiosironi/eris": "0.14.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "classmap": [
            "src/Constants.php"
        ],
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
